{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chat as customer 48",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/chat.py",
      "args": [
        "48"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/scripts",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Chat as customer 54 (owns DRM tracks)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/chat.py",
      "args": [
        "54"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/scripts",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/scripts",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-s",
        "-vv",
        "${file}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      }
    },
    {
      "name": "Pytest: all offline tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-s",
        "-vv",
        "tests"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      }
    },
    {
      "name": "Pytest: live tests (real API calls)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-s",
        "-vv",
        "-m",
        "live",
        "-o",
        "addopts="
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false,
      "env": {
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      }
    },
    {
      "name": "Find the demo customer",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/find_demo_customer.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/scripts",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Attach to langgraph dev",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ],
      "justMyCode": false,
      "env": {
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      }
    }
  ],
  "compounds": []
}
